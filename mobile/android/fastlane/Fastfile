default_platform(:android)

platform :android do
  desc "Capture Play Store screenshots via the instrumented screenshots test (see Screengrabfile)"
  lane :screenshots do
    gradle(task: "assembleDebug", project_dir: ".")
    gradle(task: "assembleAndroidTest", project_dir: ".")
    screengrab
  end

  desc "Build a signed release AAB and push it to the Play Store internal testing track"
  lane :internal do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "."
    )

    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
