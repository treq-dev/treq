# Dependencies
node_modules/

# Test artifacts built from crates/treq-mobile-ssh for jest.config.real.js
# (see scripts/build-native-test-addon.sh) - always rebuilt, never checked in.
native-test/*.node
native-test/mock_ssh_server

# React Native / Metro
.metro-health-check*
*.jsbundle

# Xcode / CocoaPods (once `npx react-native init`/`pod install` generate ios/)
ios/build/
ios/Pods/
ios/*.xcworkspace
ios/*.xcuserstate
ios/*.xcuserdatad/
ios/DerivedData/
ios/.xcode.env.local

# Android / Gradle (once a Gradle project is generated under android/)
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/*.iml
android/.idea/
android/app/release/
*.keystore
!debug.keystore

# UniFFI-generated bindings (regenerated by mobile/README.md's build steps,
# not vendored)
**/bindings/swift/
**/bindings/kotlin/

# Logs, coverage, editor/OS cruft
*.log
coverage/
.vscode/
.DS_Store

# Bundler (CocoaPods is often installed via Bundler in RN projects);
# Podfile.lock itself is intentionally NOT ignored - it should be committed
# for reproducible `pod install` runs, same as package-lock.json.
vendor/bundle/
