{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treq",
  "version": "0.3.0",
  "identifier": "com.treq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost ipc://localhost http://127.0.0.1:54321 https://xnlljmfiqyumiyexydyl.supabase.co; img-src 'self' asset: http://asset.localhost data: blob: https://lh3.googleusercontent.com https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["$HOME/**/*", "$HOME/**/.treq/**/*"],
          "deny": ["$HOME/.ssh/**"]
        }
      }
    }
  },
  "plugins": {
    "cli": {
      "description": "Treq - Stacking ADE",
      "subcommands": {
        "add": {
          "description": "Create a new workspace",
          "args": [
            {
              "name": "branch_name",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Branch name for the workspace"
            },
            {
              "name": "description",
              "short": "d",
              "takesValue": true,
              "description": "Workspace description"
            },
            {
              "name": "title",
              "short": "l",
              "takesValue": true,
              "description": "Workspace title"
            },
            {
              "name": "source-branch",
              "short": "s",
              "takesValue": true,
              "description": "Source branch to stack on"
            },
            {
              "name": "sparse",
              "short": "p",
              "takesValue": true,
              "multiple": true,
              "description": "Sparse checkout path prefix; repeatable, only matching paths are materialized"
            },
            {
              "name": "symlink",
              "short": "k",
              "takesValue": true,
              "multiple": true,
              "description": "Path to symlink from the home repo into the new workspace; repeatable (e.g. node_modules)"
            }
          ]
        },
        "set": {
          "description": "Update workspace settings",
          "args": [
            {
              "name": "workspace_name",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Workspace branch name"
            },
            {
              "name": "description",
              "short": "d",
              "takesValue": true,
              "description": "Set description"
            },
            {
              "name": "title",
              "short": "l",
              "takesValue": true,
              "description": "Set title"
            },
            {
              "name": "target-branch",
              "short": "t",
              "takesValue": true,
              "description": "Set target branch"
            }
          ]
        },
        "st": {
          "description": "Show workspace status",
          "args": [
            {
              "name": "workspace_name",
              "index": 1,
              "takesValue": true,
              "description": "Workspace name (omit to use the current workspace, or list all from the home repo)"
            }
          ]
        },
        "diff": {
          "description": "Show workspace conflicts and conflict hunks",
          "args": [
            {
              "name": "workspace_name",
              "index": 1,
              "takesValue": true,
              "description": "Workspace branch name (omit to use the current workspace)"
            }
          ]
        },
        "mv": {
          "description": "Move selected changes from source workspace to destination workspace",
          "args": [
            {
              "name": "source",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Source workspace branch name (use '.' for the home repo)"
            },
            {
              "name": "destination",
              "index": 2,
              "takesValue": true,
              "required": true,
              "description": "Destination workspace branch name (use '.' for the home repo)"
            },
            {
              "name": "files",
              "short": "f",
              "takesValue": true,
              "multiple": true,
              "description": "Files to move"
            },
            {
              "name": "ranges",
              "short": "r",
              "takesValue": true,
              "multiple": true,
              "description": "Hunk ranges in file:start-end format"
            },
            {
              "name": "commits",
              "short": "c",
              "takesValue": true,
              "multiple": true,
              "description": "Commit IDs to move"
            }
          ]
        },
        "agent": {
          "description": "Start an agent session in a workspace",
          "args": [
            {
              "name": "branch",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Workspace branch name"
            },
            {
              "name": "prompt",
              "index": 2,
              "takesValue": true,
              "required": true,
              "description": "Prompt to send to the agent"
            },
            {
              "name": "mode",
              "short": "m",
              "takesValue": true,
              "description": "Permission mode: edit or plan"
            }
          ]
        },
        "commit": {
          "description": "Commit changes in a workspace",
          "args": [
            {
              "name": "workspace_name",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Workspace branch name"
            },
            {
              "name": "message",
              "short": "m",
              "takesValue": true,
              "required": true,
              "description": "Commit message"
            },
            {
              "name": "push",
              "description": "Push to remote after committing"
            }
          ]
        },
        "resolve": {
          "description": "Resolve conflicts for a commit in a short-lived resolve workspace",
          "args": [
            {
              "name": "commit_id",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Change or commit id to resolve"
            },
            {
              "name": "sides",
              "index": 2,
              "takesValue": true,
              "multiple": true,
              "description": "Conflict sides: 1, 2, base, ours, theirs, both"
            }
          ]
        },
        "send": {
          "description": "Send a file or stdin content to the Treq UI for preview, or open a page in the in-app browser",
          "args": [
            {
              "name": "path",
              "index": 1,
              "takesValue": true,
              "description": "File path to preview, or '-' to read stdin"
            },
            {
              "name": "browser",
              "description": "Open the given localhost URL or local HTML file in the in-app browser instead of previewing it"
            }
          ]
        },
        "repo": {
          "description": "Repository inspection and status commands",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Repository action, for example inspect"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path (probe/init target, or clone destination)"
            },
            {
              "name": "value",
              "takesValue": true,
              "description": "Free-form payload: repository URL for clone"
            },
            {
              "name": "idempotency-key",
              "takesValue": true,
              "description": "Idempotency key for mutations where a retry could duplicate work"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "workspace": {
          "description": "List and inspect workspaces",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "target",
              "takesValue": true,
              "description": "Secondary id for a mutation: target branch, destination workspace, or revision"
            },
            {
              "name": "value",
              "takesValue": true,
              "description": "Free-form mutation payload: new name, message, prompt, or bookmark name"
            },
            {
              "name": "idempotency-key",
              "takesValue": true,
              "description": "Idempotency key for mutations where a retry could duplicate work"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "changes": {
          "description": "List changed files and file diffs",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "path",
              "takesValue": true,
              "description": "Repository-relative file path"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "file": {
          "description": "Read repository files",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "path",
              "takesValue": true,
              "required": true,
              "description": "Repository-relative file path"
            },
            {
              "name": "revision",
              "takesValue": true,
              "description": "working-copy or parent"
            },
            {
              "name": "start-line",
              "takesValue": true
            },
            {
              "name": "end-line",
              "takesValue": true
            },
            {
              "name": "value",
              "takesValue": true,
              "description": "Free-form payload: base64-encoded patch content for the patch action"
            },
            {
              "name": "idempotency-key",
              "takesValue": true,
              "description": "Idempotency key for mutations where a retry could duplicate work"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "commits": {
          "description": "List commits",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "target",
              "takesValue": true,
              "description": "Secondary id for a mutation: target branch, destination workspace, or revision"
            },
            {
              "name": "value",
              "takesValue": true,
              "description": "Free-form mutation payload: new name, message, prompt, or bookmark name"
            },
            {
              "name": "idempotency-key",
              "takesValue": true,
              "description": "Idempotency key for mutations where a retry could duplicate work"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "conflicts": {
          "description": "List conflicted files",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "git": {
          "description": "Git fetch, bookmark tracking, and push",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action: fetch, bookmark-track, push"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "target",
              "takesValue": true,
              "description": "Remote name for bookmark-track"
            },
            {
              "name": "value",
              "takesValue": true,
              "description": "Bookmark name for bookmark-track"
            },
            {
              "name": "idempotency-key",
              "takesValue": true,
              "description": "Idempotency key for mutations where a retry could duplicate work"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "agent-remote": {
          "description": "Coding-agent lifecycle backed by the VM-local supervisor",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action: start, input, status, stop, logs"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "takesValue": true,
              "required": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "target",
              "takesValue": true,
              "description": "Agent name for start (claude, codex, cursor-agent)"
            },
            {
              "name": "value",
              "takesValue": true,
              "description": "Free-form payload: prompt for start, input text for input"
            },
            {
              "name": "idempotency-key",
              "takesValue": true,
              "description": "Idempotency key for mutations where a retry could duplicate work"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "agent-review": {
          "description": "Local-only review comments left on a diff or file",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action: add, list, resolve, delete"
            },
            {
              "name": "target-type",
              "takesValue": true,
              "description": "What was reviewed: workspace_diff or file_browser_file"
            },
            {
              "name": "target-id",
              "takesValue": true,
              "description": "Identifier within the target type (workspace id, or absolute file path)"
            },
            {
              "name": "file",
              "takesValue": true,
              "description": "File path the comment is anchored to"
            },
            {
              "name": "start-line",
              "takesValue": true,
              "description": "First line of the anchored range"
            },
            {
              "name": "end-line",
              "takesValue": true,
              "description": "Last line of the anchored range (defaults to --start-line)"
            },
            {
              "name": "side",
              "takesValue": true,
              "description": "Diff side the range refers to: old or new"
            },
            {
              "name": "comment",
              "takesValue": true,
              "description": "Review comment text"
            },
            {
              "name": "suggestion",
              "takesValue": true,
              "description": "Suggested replacement text, optionally wrapped in a ```suggestion fence"
            },
            {
              "name": "comment-id",
              "takesValue": true,
              "description": "Comment id for resolve and delete"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "pty-remote": {
          "description": "VM-local persistent PTY sessions (tmux/screen-backed) for full terminal streaming and reattach",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action: start, list, stop, attach-command"
            },
            {
              "name": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "target",
              "takesValue": true,
              "description": "Session label"
            },
            {
              "name": "value",
              "takesValue": true,
              "description": "JSON-encoded {remote_dir, command, cols, rows} launch payload for start/attach-command"
            },
            {
              "name": "idempotency-key",
              "takesValue": true,
              "description": "Idempotency key for mutations where a retry could duplicate work"
            },
            {
              "name": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        }
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["treq"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 28
    }
  }
}
