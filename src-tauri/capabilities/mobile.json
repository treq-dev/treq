{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capability for the mobile app window",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://treq.dev/sign-in*" },
        { "url": "http://localhost:3001/sign-in*" }
      ]
    },
    "log:default",
    "deep-link:default"
  ]
}
