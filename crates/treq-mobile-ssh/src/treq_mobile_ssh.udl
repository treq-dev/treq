namespace treq_mobile_ssh {};

[Error]
enum SshError {
  "HostKeyMismatch",
  "ConnectionFailed",
  "AuthenticationFailed",
  "KeyMaterialUnavailable",
  "CommandFailed",
  "SessionNotFound",
};

dictionary DeviceKeyInfo {
  string public_key_openssh;
  string fingerprint_sha256;
  string private_key_pem;
};

dictionary ExecResult {
  i32 exit_status;
  string stdout;
  string stderr;
};

// PTY output/lifecycle events (mobile PRD Phase 7, item 2). UniFFI 0.28's
// UDL-based scaffolding (this crate is not on the proc-macro path) has no
// practical support for an async callback interface that could push these
// to Kotlin/Swift as they arrive - see the "spike result" comment on
// `poll_pty_events` in lib.rs for what was tried. Events are instead
// buffered VM-side (bounded, oldest dropped first) and drained by polling.
[Enum]
interface PtyEvent {
  Data(sequence<u8> bytes);
  ExitStatus(u32 code);
  Closed();
};

interface SshClient {
  constructor();

  // Generates a fresh ed25519 device keypair. The caller (the iOS/Android
  // native bridge, not JS) is responsible for immediately moving
  // `private_key_pem` into Keychain / Android Keystore and discarding this
  // value; it must never be forwarded across the React Native JS bridge.
  [Throws=SshError]
  DeviceKeyInfo generate_device_key();

  // Opens (or reuses a pooled) SSH connection authenticated with
  // `private_key_pem`, verifying the server host key against
  // `expected_fingerprint_sha256` before sending any credentials.
  // Returns an opaque session id used by exec_command / disconnect.
  [Throws=SshError]
  u64 connect(string host, u16 port, string username, string private_key_pem, string expected_fingerprint_sha256);

  // Same as `connect`, but authenticates with a short-lived OpenSSH user
  // certificate (`certificate_openssh`, as issued by the control plane's
  // `issue_certificate` action) plus its matching private key, instead of
  // direct public-key auth - the managed-instance path (prds/mobile.md
  // Phase 2), mirroring desktop's `authenticate_openssh_cert`.
  [Throws=SshError]
  u64 connect_with_certificate(string host, u16 port, string username, string private_key_pem, string certificate_openssh, string expected_fingerprint_sha256);

  // Runs a single allow-listed Treq CLI command over a non-interactive
  // exec channel on an already-open session.
  [Throws=SshError]
  ExecResult exec_command(u64 session_id, sequence<string> argv);

  void disconnect(u64 session_id);

  // Opens a PTY channel on `session_id`'s connection and execs `command` on
  // it (typically the literal command line `pty-remote attach-command`
  // returns). Returns an opaque pty id for pty_write/pty_resize/
  // poll_pty_events/close_pty.
  [Throws=SshError]
  u64 open_pty(u64 session_id, string term, u16 cols, u16 rows, string command);

  // Writes raw bytes to an open PTY's stdin.
  [Throws=SshError]
  void pty_write(u64 pty_id, sequence<u8> data);

  // Sends a window-change request so the remote PTY (and, when attached to
  // a `pty-remote` tmux/screen session, that session itself) resizes.
  [Throws=SshError]
  void pty_resize(u64 pty_id, u16 cols, u16 rows);

  // Drains up to max_events buffered PtyEvents, blocking up to timeout_ms
  // if none are yet available. See lib.rs's `poll_pty_events` doc comment
  // for why this is polling rather than a pushed callback.
  [Throws=SshError]
  sequence<PtyEvent> poll_pty_events(u64 pty_id, u64 timeout_ms, u32 max_events);

  // Closes a PTY session. Idempotent.
  void close_pty(u64 pty_id);
};
